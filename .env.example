# Copiá este archivo a .env.local y completá los valores. Nunca subas .env.local a Git.

# --- Aplicación ---
# URL pública: se usa para armar los enlaces de los correos (nunca se toma de la cabecera Host).
APP_URL=http://localhost:3000
NODE_ENV=development

# --- Base de datos ---
# Rol de la aplicación (NOSUPERUSER, NOBYPASSRLS). La app se niega a arrancar si el rol puede saltear RLS.
DATABASE_URL=postgres://app_user:CAMBIAR@127.0.0.1:54329/kontara
# Rol dueño del esquema: solo para migraciones (scripts y CI/CD). No lo uses en la app.
DATABASE_OWNER_URL=postgres://app_owner:CAMBIAR@127.0.0.1:54329/kontara

# PostgreSQL local embebido (npm run db:local)
LOCAL_PG_PORT=54329
LOCAL_PG_SUPERUSER_PASSWORD=CAMBIAR
LOCAL_PG_OWNER_PASSWORD=CAMBIAR
LOCAL_PG_APP_PASSWORD=CAMBIAR

# --- Criptografía ---
# 32 bytes en base64 para cifrar datos sensibles en reposo (secretos MFA, identificaciones fiscales).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# 32 bytes en base64 para firmar enlaces temporales de archivos.
SIGNING_KEY=

# --- Correo ---
# console: escribe los correos en .data/outbox (solo desarrollo). resend: envío real.
EMAIL_PROVIDER=console
EMAIL_FROM="KONTARA 27 <no-reply@example.com>"
RESEND_API_KEY=

# --- Archivos ---
# local: disco en ./storage (solo desarrollo). s3: bucket privado compatible con S3 (R2, AWS, MinIO).
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Tareas programadas ---
# Secreto que Vercel Cron envía en Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
